{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-x64-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-x64/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "MAMERECOMP_ENABLE_OPENGL_VIDEO": "ON",
        "MAMERECOMP_ENABLE_PSX_GPU_OPENGL": "ON"
      }
    },
    {
      "name": "linux-x64-dev",
      "displayName": "Linux x64 development",
      "inherits": "linux-x64-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "linux-x64-debug",
      "displayName": "Linux x64 debug",
      "inherits": "linux-x64-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-x64-release",
      "displayName": "Linux x64 release",
      "inherits": "linux-x64-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-x64-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-x64/${presetName}",
      "cacheVariables": {
        "MAMERECOMP_ENABLE_OPENGL_VIDEO": "ON",
        "MAMERECOMP_ENABLE_PSX_GPU_OPENGL": "ON"
      }
    },
    {
      "name": "windows-x64-dev",
      "displayName": "Windows x64 development",
      "inherits": "windows-x64-base"
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 debug",
      "inherits": "windows-x64-base"
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 release",
      "inherits": "windows-x64-base"
    }
  ],
  "buildPresets": [
    { "name": "linux-x64-dev", "configurePreset": "linux-x64-dev" },
    { "name": "linux-x64-debug", "configurePreset": "linux-x64-debug" },
    { "name": "linux-x64-release", "configurePreset": "linux-x64-release" },
    { "name": "windows-x64-dev", "configurePreset": "windows-x64-dev", "configuration": "RelWithDebInfo" },
    { "name": "windows-x64-debug", "configurePreset": "windows-x64-debug", "configuration": "Debug" },
    { "name": "windows-x64-release", "configurePreset": "windows-x64-release", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "linux-x64-dev", "configurePreset": "linux-x64-dev", "output": { "outputOnFailure": true } },
    { "name": "linux-x64-debug", "configurePreset": "linux-x64-debug", "output": { "outputOnFailure": true } },
    { "name": "linux-x64-release", "configurePreset": "linux-x64-release", "output": { "outputOnFailure": true } },
    { "name": "windows-x64-dev", "configurePreset": "windows-x64-dev", "configuration": "RelWithDebInfo", "output": { "outputOnFailure": true } },
    { "name": "windows-x64-debug", "configurePreset": "windows-x64-debug", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "windows-x64-release", "configurePreset": "windows-x64-release", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
