#version 430 core
layout(local_size_x=8, local_size_y=8) in;
layout(binding=0) uniform usampler2D uTileAtlas;
layout(binding=1) uniform usampler2D uTileRam;
layout(binding=2) uniform usampler2D uTextRam;
layout(std430, binding=0) buffer PaletteOutput { uint outPalette[]; };
layout(std430, binding=1) buffer PriorityOutput { uint outPriority[]; };
uniform int uDisplayEnable;
uniform int uFlip;
uniform int uRowScrollEnable;
uniform int uColumnScrollEnable;
uint tileByte(uint address) { return texelFetch(uTileRam, ivec2(int(address & 255u), int(address >> 8)), 0).r; }
uint textByte(uint address) { return texelFetch(uTextRam, ivec2(int(address & 255u), int(address >> 8)), 0).r; }
uint tileWord(uint address) { return (tileByte(address) << 8) | tileByte(address + 1u); }
uint textWord(uint address) { return (textByte(address) << 8) | textByte(address + 1u); }
uint reverseNibble(uint value) {
    return ((value & 1u) << 3) | ((value & 2u) << 1) | ((value & 4u) >> 1) | ((value & 8u) >> 3);
}
uint tilePen(uint code, uint x, uint y) {
    uint atlasX = (code & 127u) * 8u + (x & 7u);
    uint atlasY = (code >> 7) * 8u + (y & 7u);
    return texelFetch(uTileAtlas, ivec2(int(atlasX), int(atlasY)), 0).r;
}
uint pagePixel(bool background, uint screenX, uint screenY, out uint category, out uint pen) {
    uint layer = background ? 1u : 0u;
    uint pageRegister = uFlip != 0 ? (background ? 0xe8cu : 0xe8eu) : (background ? 0xe9cu : 0xe9eu);
    uint pages = textWord(pageRegister);
    pages = ((pages >> 4) & 0x0707u) | ((pages << 4) & 0x7070u);
    if (uFlip != 0) {
        uint reversed = 0u;
        for (uint quadrant = 0u; quadrant < 4u; ++quadrant)
            reversed |= reverseNibble((pages >> (quadrant * 4u)) & 0xfu) << (quadrant * 4u);
        pages = reversed;
    }
    uint globalX = textWord(background ? 0xffau : 0xff8u) & 0x1ffu;
    uint globalY = textWord(background ? 0xf26u : 0xf24u) & 0xffu;
    int rowChunkY = int(screenY & ~7u);
    int rowIndex = uFlip != 0 ? (216 - rowChunkY) / 8 : rowChunkY / 8;
    uint columnIndex = screenX / 16u;
    uint rawX = globalX;
    uint rawY = globalY;
    if (uRowScrollEnable != 0)
        rawX = textWord(uint(0xf80 + rowIndex * 4) + layer * 2u) & 0x1ffu;
    if (uColumnScrollEnable != 0)
        rawY = textWord(0xf30u + columnIndex * 4u + layer * 2u) & 0xffu;
    if (uFlip != 0) rawX += 17u;
    uint scrollX = (0xc8u - rawX) & 0x3ffu;
    uint scrollY = rawY & 0x1ffu;
    uint drawX = uFlip != 0 ? 319u - screenX : screenX;
    uint drawY = uFlip != 0 ? 223u - screenY : screenY;
    uint virtualX = (drawX + scrollX) & 0x3ffu;
    uint virtualY = (drawY + scrollY) & 0x1ffu;
    uint quadrant = ((virtualY >> 8) * 2u) + (virtualX >> 9);
    uint page = (pages >> (quadrant * 4u)) & 0xfu;
    uint tileX = (virtualX & 0x1ffu) >> 3;
    uint tileY = (virtualY & 0xffu) >> 3;
    uint data = tileWord((page * 2048u + tileY * 64u + tileX) * 2u);
    category = (data >> 12) & 1u;
    uint code = ((data >> 1) & 0x1000u) | (data & 0xfffu);
    pen = tilePen(code, virtualX, virtualY);
    return ((data >> 5) & 0x7fu) * 8u + pen;
}
void main() {
    uvec2 position = gl_GlobalInvocationID.xy;
    if (position.x >= 320u || position.y >= 224u) return;
    uint pixel = position.y * 320u + position.x;
    uint colorIndex = 0u;
    uint priority = 0u;
    if (uDisplayEnable != 0) {
        uint category, pen;
        colorIndex = pagePixel(true, position.x, position.y, category, pen);
        if (pen != 0u) priority |= 1u << category;
        uint screenX = uFlip != 0 ? 319u - position.x : position.x;
        uint screenY = uFlip != 0 ? 223u - position.y : position.y;
        uint mapX = (screenX + 192u) & 0x1ffu;
        uint mapY = screenY & 0xffu;
        uint textData = textWord(((mapY >> 3) * 64u + (mapX >> 3)) * 2u);
        uint textCategory = (textData >> 11) & 1u;
        uint foregroundColor = pagePixel(false, position.x, position.y, category, pen);
        if (pen != 0u) {
            colorIndex = foregroundColor;
            priority |= 2u << category;
        }
        pen = tilePen(textData & 0xffu, mapX, mapY);
        if (pen != 0u) {
            colorIndex = ((textData >> 8) & 7u) * 8u + pen;
            priority |= 4u << textCategory;
        }
    }
    outPalette[pixel] = colorIndex;
    outPriority[pixel] = priority;
}
