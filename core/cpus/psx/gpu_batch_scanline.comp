#version 430 core
layout(local_size_x = 1, local_size_y = 64) in;

struct ShaderVertex {
    ivec4 xyuv;
    uint color;
    uint padding0;
    uint padding1;
    uint padding2;
};
struct ShaderCommand {
    uvec4 header;
    ivec4 draw_area;
    ivec4 offset_window;
    ivec4 window_flip;
    uvec4 texture;
    ShaderVertex vertices[4];
    ivec4 bounds;
    ivec4 batch_scanline;
};
struct BatchPolygonJob {
    ivec4 data;
};
struct BatchScanline {
    ivec4 start0;
    ivec4 start1;
    ivec4 step0;
    ivec4 step1;
    ivec4 span;
};

layout(std430, binding = 2) readonly buffer BatchCommands {
    ShaderCommand commands[];
};
layout(std430, binding = 3) readonly buffer BatchPolygonJobs {
    BatchPolygonJob jobs[];
};
layout(std430, binding = 4) writeonly buffer BatchScanlines {
    BatchScanline scanlines[];
};
uniform int uPolygonJobCount;

int polygon_x(ShaderCommand command, int point) {
    return command.vertices[point].xyuv.x;
}
int polygon_y(ShaderCommand command, int point) {
    return command.vertices[point].xyuv.y;
}
int polygon_attribute(ShaderCommand command, int point, int field_id) {
    if (field_id == 0) return polygon_x(command, point);
    if (field_id == 1) return command.vertices[point].xyuv.z;
    if (field_id == 2) return command.vertices[point].xyuv.w;
    uint color = command.vertices[point].color;
    if (field_id == 3) return int(color & 255u);
    if (field_id == 4) return int((color >> 8) & 255u);
    return int((color >> 16) & 255u);
}
int polygon_next(int point, int count, bool alternate) {
    if (count == 3) return point == 2 ? 0 : point + 1;
    if (alternate) {
        if (point == 0) return 0;
        if (point == 1) return 3;
        if (point == 2) return 1;
        return 2;
    }
    if (point == 0) return 1;
    if (point == 1) return 3;
    if (point == 2) return 0;
    return 2;
}
int polygon_prev(int point, int count, bool alternate) {
    if (count == 3) return point == 0 ? 2 : point - 1;
    if (alternate) {
        if (point == 0) return 0;
        if (point == 1) return 2;
        if (point == 2) return 3;
        return 1;
    }
    if (point == 0) return 2;
    if (point == 1) return 0;
    if (point == 2) return 3;
    return 1;
}
bool polygon_cull_point(ShaderCommand command, int a, int b) {
    return abs(polygon_x(command, a) - polygon_x(command, b)) > 1023 ||
           abs(polygon_y(command, a) - polygon_y(command, b)) > 1023;
}
bool polygon_cull_triangle(ShaderCommand command, int first) {
    int a = first, b = first + 1, c = first + 2;
    return polygon_cull_point(command, a, b) ||
           polygon_cull_point(command, b, c) ||
           polygon_cull_point(command, c, a);
}
int polygon_edge_fixed(ShaderCommand command, int from, int to,
                       int scan_y, int field_id) {
    int y0 = polygon_y(command, from);
    int dy = polygon_y(command, to) - y0;
    if (dy <= 0) return 0;
    int first = polygon_attribute(command, from, field_id);
    int last = polygon_attribute(command, to, field_id);
    int slope = ((last - first) * 65536) / dy;
    return first * 65536 + slope * (scan_y - y0);
}

void main() {
    uint job_index = gl_GlobalInvocationID.x;
    if (job_index >= uint(uPolygonJobCount)) return;

    BatchPolygonJob job = jobs[job_index];
    ShaderCommand command = commands[job.data.x];
    int row_offset = int(gl_GlobalInvocationID.y);
    if (row_offset >= command.batch_scanline.z) return;
    int scan_y = command.batch_scanline.y + row_offset;
    int row_index = command.batch_scanline.x + row_offset;
    BatchScanline row;
    row.start0 = ivec4(0);
    row.start1 = ivec4(0);
    row.step0 = ivec4(0);
    row.step1 = ivec4(0);
    row.span = ivec4(0);

    int count = int(command.header.y);
    bool alternate = false;
    int first_candidate = 0;
    int left_top = 0;
    if (count == 4) {
        if (polygon_cull_triangle(command, 0)) {
            if (polygon_cull_triangle(command, 1)) {
                scanlines[row_index] = row;
                return;
            }
            alternate = true;
            first_candidate = 1;
            left_top = 1;
        } else if (polygon_cull_triangle(command, 1)) {
            count = 3;
        }
    } else if (count != 3 || polygon_cull_triangle(command, 0)) {
        scanlines[row_index] = row;
        return;
    }

    for (int point = first_candidate; point < count; ++point) {
        int y = polygon_y(command, point);
        int top_y = polygon_y(command, left_top);
        if (y < top_y || (y == top_y && polygon_x(command, point) <
                                         polygon_x(command, left_top)))
            left_top = point;
    }

    int left_from = -1, left_to = -1;
    int right_from = -1, right_to = -1;
    int point = left_top;
    for (int step = 0; step < count; ++step) {
        int next_point = polygon_prev(point, count, alternate);
        if (polygon_y(command, point) <= scan_y &&
            scan_y < polygon_y(command, next_point)) {
            left_from = point;
            left_to = next_point;
            break;
        }
        point = next_point;
    }
    point = left_top;
    for (int step = 0; step < count; ++step) {
        int next_point = polygon_next(point, count, alternate);
        if (polygon_y(command, point) <= scan_y &&
            scan_y < polygon_y(command, next_point)) {
            right_from = point;
            right_to = next_point;
            break;
        }
        point = next_point;
    }

    if (left_from >= 0 && right_from >= 0) {
        int left_x = polygon_edge_fixed(command, left_from, left_to,
                                        scan_y, 0) >> 16;
        int right_x = polygon_edge_fixed(command, right_from, right_to,
                                         scan_y, 0) >> 16;
        if (left_x != right_x) {
            bool left_is_first = left_x < right_x;
            row.span = ivec4(min(left_x, right_x), max(left_x, right_x), 1, 0);
            int distance = row.span.y - row.span.x;
            if (distance > 0) {
                for (int field_id = 1; field_id < 6; ++field_id) {
                    int left = polygon_edge_fixed(command, left_from, left_to,
                                                  scan_y, field_id);
                    int right = polygon_edge_fixed(command, right_from, right_to,
                                                   scan_y, field_id);
                    int start = left_is_first ? left : right;
                    int end = left_is_first ? right : left;
                    int attribute_index = field_id - 1;
                    if (attribute_index < 4) {
                        row.start0[attribute_index] = start;
                        row.step0[attribute_index] = (end - start) / distance;
                    } else {
                        row.start1.x = start;
                        row.step1.x = (end - start) / distance;
                    }
                }
            }
        }
    }

    scanlines[row_index] = row;
}
