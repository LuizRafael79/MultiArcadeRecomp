#version 430 core
layout(local_size_x = 8, local_size_y = 8) in;
layout(r16ui, binding = 0) uniform uimage2D uDestination;
layout(binding = 1) uniform usampler2D uSource;

struct Vertex {
    ivec4 xyuv;
    uint color;
    uint pad0;
    uint pad1;
    uint pad2;
};
struct Command {
    uvec4 header;       // kind, vertex count, flags, RGB/555 color
    ivec4 draw_area;
    ivec4 offset_window;
    ivec4 window_flip;
    uvec4 texture;      // tpage, CLUT, GPU type, reserved
    Vertex vertices[4];
    ivec4 bounds;
};
layout(std430, binding = 0) readonly buffer CommandBuffer { Command command; };
uniform ivec2 uDispatchOrigin;
uniform int uVramHeight;

float edge(ivec2 a, ivec2 b, vec2 p) {
    return (p.x - float(a.x)) * float(b.y - a.y) -
           (p.y - float(a.y)) * float(b.x - a.x);
}
bool triangle_weights(ivec2 a, ivec2 b, ivec2 c, vec2 p, out vec3 w) {
    float area = edge(a, b, vec2(c));
    if (abs(area) < 0.5) return false;
    w = vec3(edge(b, c, p), edge(c, a, p), edge(a, b, p)) / area;
    return all(greaterThanEqual(w, vec3(-0.0001)));
}
uint vram_word(int x, int y) {
    int pixel_mask = (uVramHeight * 1024) - 1;
    int index = int(uint(y * 1024 + x) & uint(pixel_mask));
    return texelFetch(uSource, ivec2(index & 1023, index >> 10), 0).r;
}
uint sample_texture(int u, int v) {
    uint tpage = command.texture.x;
    uint gpu_type = command.texture.z;
    int depth = gpu_type == 2u ? int((tpage >> 7) & 3u) : int((tpage >> 9) & 3u);
    if (depth == 3) return 0u;
    u &= command.window_flip.x;
    v &= command.window_flip.y;
    int ppw = depth == 0 ? 4 : depth == 1 ? 2 : 1;
    int page_x = int(tpage & 15u) * 64;
    int page_y = gpu_type == 2u
        ? int(((tpage & 0x10u) << 4) | ((tpage & 0x800u) >> 2))
        : int(tpage & 0x60u) << 3;
    int base_x = page_x + command.offset_window.z / ppw;
    int base_y = page_y + command.offset_window.w;
    if (depth == 2) return vram_word(base_x + u, base_y + v);
    int tex_x = u / ppw;
    int tex_y = v;
    if (gpu_type != 2u && (tpage & 0x2000u) != 0u && depth == 0) {
        tex_x = ((u >> 2) & ~0x3c) + ((v << 2) & 0x3c);
        tex_y = (v & ~0xf) + ((u >> 4) & 0xf);
    } else if (gpu_type != 2u && (tpage & 0x2000u) != 0u && depth == 1) {
        tex_x = ((u >> 1) & ~0x78) + ((u << 2) & 0x40) + ((v << 3) & 0x38);
        tex_y = (v & ~0x7) + ((u >> 5) & 0x7);
    }
    uint packed_word = vram_word(base_x + tex_x, base_y + tex_y);
    uint index = depth == 0 ? ((packed_word >> uint((u & 3) * 4)) & 15u)
                            : ((packed_word >> uint((u & 1) * 8)) & 255u);
    int clut_x = int(command.texture.y & 63u) * 16;
    int clut_y = int((command.texture.y >> 6) & 1023u);
    return vram_word(clut_x + int(index), clut_y);
}
uint blend555(uint back, uint front, uint mode) {
    uvec3 b = uvec3(back & 31u, (back >> 5) & 31u, (back >> 10) & 31u);
    uvec3 f = uvec3(front & 31u, (front >> 5) & 31u, (front >> 10) & 31u);
    uvec3 c;
    if (mode == 0u) c = (b + f) >> 1;
    else if (mode == 1u) c = min(uvec3(31u), b + f);
    else if (mode == 2u) c = uvec3(max(ivec3(b) - ivec3(f), ivec3(0)));
    else c = min(uvec3(31u), b + (f >> 2));
    return c.x | (c.y << 5) | (c.z << 10) | (front & 0x8000u);
}
int dither_offset(ivec2 pixel) {
    const int matrix[16] = int[16](
        -4, 0, -3, 1, 2, -2, 3, -1,
        -3, 1, -4, 0, 3, -1, 2, -2);
    return matrix[(pixel.y & 3) * 4 + (pixel.x & 3)];
}
uint quantize_dithered(int value, int offset) {
    return uint(clamp((value + offset) >> 3, 0, 31));
}
int floor_fixed16(int value) {
    return value >= 0 ? value / 65536 : -((-value + 65535) / 65536);
}
int polygon_next(int point, int count, bool alternate) {
    if (count == 3) return point == 2 ? 0 : point + 1;
    if (alternate) {
        if (point == 0) return 0;
        if (point == 1) return 3;
        if (point == 2) return 1;
        return 2;
    }
    if (point == 0) return 1;
    if (point == 1) return 3;
    if (point == 2) return 0;
    return 2;
}
int polygon_prev(int point, int count, bool alternate) {
    if (count == 3) return point == 0 ? 2 : point - 1;
    if (alternate) {
        if (point == 0) return 0;
        if (point == 1) return 2;
        if (point == 2) return 3;
        return 1;
    }
    if (point == 0) return 2;
    if (point == 1) return 0;
    if (point == 2) return 3;
    return 1;
}
int polygon_x(int point) { return command.vertices[point].xyuv.x; }
int polygon_y(int point) { return command.vertices[point].xyuv.y; }
int polygon_attribute(int point, int field_id) {
    if (field_id == 0) return polygon_x(point);
    if (field_id == 1) return command.vertices[point].xyuv.z;
    if (field_id == 2) return command.vertices[point].xyuv.w;
    uint color = command.vertices[point].color;
    if (field_id == 3) return int(color & 255u);
    if (field_id == 4) return int((color >> 8) & 255u);
    return int((color >> 16) & 255u);
}
bool polygon_cull_point(int a, int b) {
    return abs(polygon_x(a) - polygon_x(b)) > 1023 ||
           abs(polygon_y(a) - polygon_y(b)) > 1023;
}
bool polygon_cull_triangle(int first) {
    int a = first, b = first + 1, c = first + 2;
    return polygon_cull_point(a, b) || polygon_cull_point(b, c) ||
           polygon_cull_point(c, a);
}
int polygon_edge_fixed(int from, int to, int scan_y, int field_id) {
    int y0 = polygon_y(from);
    int dy = polygon_y(to) - y0;
    if (dy <= 0) return 0;
    int first = polygon_attribute(from, field_id);
    int last = polygon_attribute(to, field_id);
    int slope = ((last - first) * 65536) / dy;
    return first * 65536 + slope * (scan_y - y0);
}
bool polygon_scanline_sample(ivec2 pixel, out ivec2 uv, out ivec3 color) {
    int count = int(command.header.y);
    bool alternate = false;
    int first_candidate = 0;
    int left_top = 0;
    if (count == 4) {
        if (polygon_cull_triangle(0)) {
            if (polygon_cull_triangle(1)) return false;
            alternate = true;
            first_candidate = 1;
            left_top = 1;
        } else if (polygon_cull_triangle(1)) {
            count = 3;
        }
    } else if (count != 3 || polygon_cull_triangle(0)) {
        return false;
    }
    for (int point = first_candidate; point < count; ++point) {
        int y = polygon_y(point);
        int top_y = polygon_y(left_top);
        if (y < top_y || (y == top_y && polygon_x(point) < polygon_x(left_top)))
            left_top = point;
    }

    int left_from = -1;
    int left_to = -1;
    int right_from = -1;
    int right_to = -1;
    int point = left_top;
    for (int step = 0; step < count; ++step) {
        int next_point = polygon_prev(point, count, alternate);
        if (polygon_y(point) <= pixel.y && pixel.y < polygon_y(next_point)) {
            left_from = point;
            left_to = next_point;
            break;
        }
        point = next_point;
    }
    point = left_top;
    for (int step = 0; step < count; ++step) {
        int next_point = polygon_next(point, count, alternate);
        if (polygon_y(point) <= pixel.y && pixel.y < polygon_y(next_point)) {
            right_from = point;
            right_to = next_point;
            break;
        }
        point = next_point;
    }
    if (left_from < 0 || right_from < 0) return false;

    int left_x = polygon_edge_fixed(left_from, left_to, pixel.y, 0) >> 16;
    int right_x = polygon_edge_fixed(right_from, right_to, pixel.y, 0) >> 16;
    if (left_x == right_x) return false;
    int left_fixed[5];
    int right_fixed[5];
    for (int field_id = 1; field_id < 6; ++field_id) {
        left_fixed[field_id - 1] = polygon_edge_fixed(
            left_from, left_to, pixel.y, field_id);
        right_fixed[field_id - 1] = polygon_edge_fixed(
            right_from, right_to, pixel.y, field_id);
    }
    bool left_is_first = left_x < right_x;
    int x_start = min(left_x, right_x);
    int x_end = max(left_x, right_x);
    int distance = x_end - x_start;
    if (distance <= 0 || pixel.x < x_start || pixel.x >= x_end) return false;
    for (int field_id = 0; field_id < 5; ++field_id) {
        int start = left_is_first ? left_fixed[field_id] : right_fixed[field_id];
        int end = left_is_first ? right_fixed[field_id] : left_fixed[field_id];
        int delta = (end - start) / distance;
        int value = (start + delta * (pixel.x - x_start)) >> 16;
        if (field_id == 0) uv.x = value;
        else if (field_id == 1) uv.y = value;
        else color[field_id - 2] = value;
    }
    return true;
}
void main() {
    ivec2 p = uDispatchOrigin + ivec2(gl_GlobalInvocationID.xy);
    if (p.x < command.bounds.x || p.y < command.bounds.y ||
        p.x > command.bounds.z || p.y > command.bounds.w ||
        p.x < 0 || p.y < 0 || p.x >= 1024 || p.y >= uVramHeight) return;
    if ((command.header.z & 128u) != 0u &&
        (uint(p.y) & 1u) == ((command.texture.w >> 8) & 1u)) return;
    uint kind = command.header.x;
    // GP0 polygon texels are stepped at integer scanline coordinates by the
    // PSX/MAME path. Keep rectangle and line rasterization at pixel centers.
    vec2 center = vec2(p) + (kind == 0u ? vec2(0.0) : vec2(0.5));
    uint result = command.header.w;
    bool covered = false;
    vec3 weights = vec3(0.0);
    ivec2 polygon_uv = ivec2(0);
    ivec3 polygon_color = ivec3(0);
    int tri[3];
    if (kind == 2u || kind == 4u) {
        covered = true;
    } else if (kind == 3u) {
        Vertex a = command.vertices[0];
        Vertex b = command.vertices[1];
        ivec2 delta = b.xyuv.xy - a.xyuv.xy;
        int steps = max(1, max(abs(delta.x), abs(delta.y)));
        int step_index;
        if (abs(delta.x) >= abs(delta.y) && delta.x != 0)
            step_index = delta.x > 0 ? p.x - a.xyuv.x : a.xyuv.x - p.x;
        else if (delta.y != 0)
            step_index = delta.y > 0 ? p.y - a.xyuv.y : a.xyuv.y - p.y;
        else
            step_index = 0;
        if (step_index < 0 || step_index >= steps) return;
        ivec2 delta_fixed = (delta * 65536) / steps;
        ivec2 position_fixed = a.xyuv.xy * 65536 + step_index * delta_fixed;
        if (floor_fixed16(position_fixed.x) != p.x ||
            floor_fixed16(position_fixed.y) != p.y)
            return;
        covered = true;
        if ((command.header.z & 1u) != 0u ||
            (command.header.z & 64u) != 0u) {
            ivec3 c0 = ivec3(a.color & 255u, (a.color >> 8) & 255u,
                             (a.color >> 16) & 255u);
            ivec3 c1 = ivec3(b.color & 255u, (b.color >> 8) & 255u,
                             (b.color >> 16) & 255u);
            ivec3 delta_color_fixed = ((c1 - c0) * 65536) / steps;
            ivec3 color_fixed = c0 * 65536 + step_index * delta_color_fixed;
            ivec3 color = (command.header.z & 1u) != 0u
                ? (color_fixed >> 16)
                : ivec3(a.color & 255u, (a.color >> 8) & 255u,
                        (a.color >> 16) & 255u);
            const int offset = (command.header.z & 64u) != 0u
                ? dither_offset(p) : 0;
            result = quantize_dithered(color.r, offset) |
                     (quantize_dithered(color.g, offset) << 5) |
                     (quantize_dithered(color.b, offset) << 10);
        }
    } else if (kind == 0u) {
        covered = polygon_scanline_sample(p, polygon_uv, polygon_color);
    } else {
        tri[0] = 0; tri[1] = 1; tri[2] = 2;
        covered = triangle_weights(command.vertices[0].xyuv.xy,
            command.vertices[1].xyuv.xy, command.vertices[2].xyuv.xy, center, weights);
        if (!covered && command.header.y == 4u) {
            // GP0 quads arrive as a triangle strip: (0,1,2), then (2,1,3).
            tri[0] = 2; tri[1] = 1; tri[2] = 3;
            covered = triangle_weights(command.vertices[2].xyuv.xy,
                command.vertices[1].xyuv.xy, command.vertices[3].xyuv.xy, center, weights);
        }
    }
    if (!covered) return;
    if (kind == 2u) {
        uint destination = imageLoad(uDestination, p).r;
        if ((command.header.z & 32u) != 0u && (destination & 0x8000u) != 0u) return;
    } else if (kind == 4u) {
        int sx = command.vertices[0].xyuv.x + (p.x - command.bounds.x);
        int sy = command.vertices[0].xyuv.y + (p.y - command.bounds.y);
        sx &= 1023;
        result = texelFetch(uSource, ivec2(sx, sy), 0).r;
    } else if (kind == 3u) {
        if (p.x < command.draw_area.x || p.y < command.draw_area.y ||
            p.x > command.draw_area.z || p.y > command.draw_area.w) return;
    } else if (kind != 3u) {
        if (p.x < command.draw_area.x || p.y < command.draw_area.y ||
            p.x > command.draw_area.z || p.y > command.draw_area.w) return;
        int ia = tri[0], ib = tri[1], ic = tri[2];
        result = command.header.w;
        ivec3 shade = kind == 0u ? polygon_color :
            ivec3(command.vertices[0].color & 255u,
                  (command.vertices[0].color >> 8) & 255u,
                  (command.vertices[0].color >> 16) & 255u);
        if ((command.header.z & 1u) != 0u) {
            vec3 color = kind == 0u ? vec3(polygon_color) :
                vec3(command.vertices[ia].color & 255u,
                    (command.vertices[ia].color >> 8) & 255u,
                    (command.vertices[ia].color >> 16) & 255u) * weights.x +
                vec3(command.vertices[ib].color & 255u,
                    (command.vertices[ib].color >> 8) & 255u,
                    (command.vertices[ib].color >> 16) & 255u) * weights.y +
                vec3(command.vertices[ic].color & 255u,
                    (command.vertices[ic].color >> 8) & 255u,
                    (command.vertices[ic].color >> 16) & 255u) * weights.z;
            shade = ivec3(clamp(color, vec3(0.0), vec3(255.0)));
            const int offset = (command.header.z & 64u) != 0u
                ? dither_offset(p) : 0;
            result = quantize_dithered(shade.r, offset) |
                (quantize_dithered(shade.g, offset) << 5) |
                (quantize_dithered(shade.b, offset) << 10);
        }
        if ((command.header.z & 2u) != 0u) {
            ivec2 uv = kind == 0u ? polygon_uv : ivec2(
                vec2(command.vertices[ia].xyuv.zw) * weights.x +
                vec2(command.vertices[ib].xyuv.zw) * weights.y +
                vec2(command.vertices[ic].xyuv.zw) * weights.z);
            uint texel = sample_texture(uv.x, uv.y);
            if (texel == 0u) return;
            if ((command.header.z & 4u) == 0u) {
                ivec3 tex = ivec3(int(texel & 31u), int((texel >> 5) & 31u),
                                  int((texel >> 10) & 31u));
                const int offset = (command.header.z & 64u) != 0u
                    ? dither_offset(p) : 0;
                result = quantize_dithered((tex.r * shade.r) >> 4, offset) |
                         (quantize_dithered((tex.g * shade.g) >> 4, offset) << 5) |
                         (quantize_dithered((tex.b * shade.b) >> 4, offset) << 10) |
                         (texel & 0x8000u);
            } else result = texel;
            if ((command.header.z & 8u) != 0u && (texel & 0x8000u) != 0u)
                result = blend555(texelFetch(uSource, p, 0).r, result,
                    command.texture.w & 3u);
        }
    }
    // Draw primitives read blending and check-mask state from the current
    // VRAM texture. The ping-pong destination is only a write target and can
    // contain an older copy outside the last dirty rectangle.
    uint old = (kind == 0u || kind == 1u)
        ? texelFetch(uSource, p, 0).r : imageLoad(uDestination, p).r;
    if ((command.header.z & 32u) != 0u && (old & 0x8000u) != 0u) return;
    // Textured primitives already apply semitransparency above, and only when
    // the sampled texel has STP set. Untextured primitives blend every covered
    // pixel. Do not blend textured pixels a second time here.
    bool textured = (command.header.z & 2u) != 0u;
    if ((command.header.z & 8u) != 0u &&
        (kind == 3u || ((kind == 0u || kind == 1u) && !textured)))
        result = blend555(old, result, command.texture.w & 3u);
    if ((command.header.z & 16u) != 0u) result |= 0x8000u;
    imageStore(uDestination, p, uvec4(result, 0u, 0u, 0u));
}
