-- Generated by tools/ki/build.py for one local MAME capture.
local target_frame = @@FRAME@@
local ram0_path = @@RAM0@@
local ram2_path = @@RAM2@@
local machine = manager.machine
local space = machine.devices[":maincpu"].spaces["program"]

local function dump(path, first, last)
    -- Read one little-endian R4600 word per address step.
    local data = space:read_range(first, last, 32, 4)
    if #data ~= last - first + 1 then
        error(string.format("short MAME read at %08x-%08x: got %d bytes",
            first, last, #data))
    end
    local file, why = io.open(path, "wb")
    if not file then error("cannot open RAM snapshot " .. path .. ": " .. tostring(why)) end
    file:write(data)
    file:close()
end

local frames = 0
local captured = false
emu.register_frame_done(function()
    if captured then return end
    frames = frames + 1
    if frames < target_frame then return end
    captured = true
    dump(ram0_path, 0x00000000, 0x0007ffff)
    dump(ram2_path, 0x08000000, 0x087fffff)
    print(string.format("MultiArcadeRecomp KI RAM snapshot captured at frame %d", frames))
    machine:exit()
end, "MultiArcadeRecomp KI RAM capture")
